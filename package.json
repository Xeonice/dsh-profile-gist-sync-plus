{
  "name": "dsh-profile-gist-sync-plus",
  "version": "1.3.0",
  "type": "module",
  "description": "Back up a DSH profile to a GitHub Gist. Preview configuration changes and missing plugins before restoring on another machine. · 把 DSH 配置备份到 Gist；在另一台机器先预览配置变更和缺失插件，再确认恢复。",
  "icon": "icon.svg",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "test/*.mjs",
    "assets/icon-256.png",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "test": "node test/run.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "config",
    "backup",
    "gist",
    "sync",
    "profile"
  ],
  "author": "Meta-Virgo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xeonice/dsh-profile-gist-sync-plus.git"
  },
  "homepage": "https://github.com/Xeonice/dsh-profile-gist-sync-plus#readme",
  "bugs": {
    "url": "https://github.com/Xeonice/dsh-profile-gist-sync-plus/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
